<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Todo0</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #f7f7f7;
      color: #222;
    }
    .container {
      max-width: 420px;
      margin: 2em auto;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      padding: 2em 1.5em 1.5em 1.5em;
    }
    h1 {
      font-size: 1.7em;
      margin-bottom: 1em;
      color: #2d5be3;
    }
    form {
      margin-bottom: 1em;
    }
    input[type=text] {
      padding: 0.5em;
      border-radius: 4px;
      border: 1px solid #bbb;
      font-size: 1em;
      width: 60%;
      margin-right: 0.5em;
    }
    button {
      padding: 0.5em 1em;
      border-radius: 4px;
      border: none;
      background: #2d5be3;
      color: #fff;
      font-size: 1em;
      cursor: pointer;
      margin-right: 0.2em;
    }
    button:hover {
      background: #1741a6;
    }
    ul {
      list-style: none;
      padding: 0;
    }
    li {
      margin-bottom: 0.7em;
      background: #f2f6ff;
      border-radius: 4px;
      padding: 0.6em 0.8em;
      display: flex;
      align-items: center;
      gap: 0.5em;
    }
    .done {
      text-decoration: line-through;
      color: #888;
      background: #e0e7ff;
    }
    .token-box {
      background: #f2f6ff;
      padding: 0.7em;
      border-radius: 4px;
      border: 1px solid #e0e7ff;
      margin-bottom: 1em;
      font-size: 0.97em;
      word-break: break-all;
    }
    .token-input {
      width: 100%;
      font-family: monospace;
      font-size: 0.97em;
      border: none;
      background: transparent;
      color: #2d5be3;
    }
    .copy-btn {
      background: #2d5be3;
      color: #fff;
      border: none;
      border-radius: 4px;
      padding: 0.3em 0.8em;
      font-size: 0.97em;
      cursor: pointer;
      margin-left: 0.5em;
    }
    .copy-btn:hover {
      background: #1741a6;
    }
    .logout-btn {
      width: 100%;
      background: #e34c4c;
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 4px;
      padding: 0.7em 0;
      font-size: 1em;
      cursor: pointer;
      margin-top: 1.5em;
    }
    .logout-btn:hover {
      background: #b92d2d;
    }
  </style>
</head>
<body>
  <div class="container">
    <% if (!authenticated) { %>
      <h1>Todo0</h1>
      <form action="/login" method="GET">
        <button type="submit">Login</button>
      </form>
    <% } else { %>
      <h1>Todo0</h1>
      <form action="/todos" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="text" name="title" placeholder="New todo" required />
        <button type="submit">Add</button>
      </form>
      <ul id="todoList">
        <% todos.forEach(todo => { %>
          <li class="<%= todo.completed ? 'done' : '' %>">
            <span style="flex:1"><%= todo.title %></span>
            <form action="/todos/<%= todo.id %>/complete" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit"><%= todo.completed ? 'Undo' : 'Complete' %></button>
            </form>
            <form action="/todos/<%= todo.id %>/delete" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit">Delete</button>
            </form>
          </li>
        <% }) %>
      </ul>
      <p id="liveHint" style="font-size:0.8em;color:#888;margin:0.2em 0 0;">🟢 live — new todos appear automatically</p>
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="logout-btn">Logout</button>
      </form>
    <% } %>
  </div>

  <script>
    function copyToken() {
      const tokenInput = document.getElementById('accessToken');
      tokenInput.select();
      document.execCommand('copy');
      alert('Access token copied to clipboard!');
    }

    // ── Live updates ─────────────────────────────────────────────────────────
    // Poll the JSON todos endpoint so todos added out-of-band (e.g. by agent0
    // or Agent B via the MCP server — a separate process sharing the DB) show
    // up without a manual refresh. Re-renders only when the list changes.
    (function () {
      const list = document.getElementById('todoList');
      if (!list) return; // not authenticated
      const csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

      function esc(s) {
        const d = document.createElement('div');
        d.textContent = s == null ? '' : String(s);
        return d.innerHTML;
      }

      let lastSig = null;
      function render(todos) {
        const sig = JSON.stringify(todos.map((t) => [t.id, t.title, t.completed]));
        if (sig === lastSig) return;
        lastSig = sig;
        list.innerHTML = todos.map((t) => `
          <li class="${t.completed ? 'done' : ''}">
            <span style="flex:1">${esc(t.title)}</span>
            <form action="/todos/${t.id}/complete" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="${esc(csrf)}" />
              <button type="submit">${t.completed ? 'Undo' : 'Complete'}</button>
            </form>
            <form action="/todos/${t.id}/delete" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="${esc(csrf)}" />
              <button type="submit">Delete</button>
            </form>
          </li>`).join('');
      }

      async function poll() {
        try {
          const r = await fetch('/todos', { credentials: 'include', headers: { Accept: 'application/json' } });
          if (!r.ok) return;
          const data = await r.json();
          if (Array.isArray(data.todos)) render(data.todos);
        } catch (_) { /* transient; try again next tick */ }
      }

      setInterval(poll, 1500);
      poll();
    })();
  </script>
</body>
</html>
