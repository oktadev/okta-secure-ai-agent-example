# ============================================================================
# AGENT B — SERVER CONFIGURATION
# ============================================================================
AGENTB_PORT=5005
# This agent's a2a-server resourceUrl (the audience inbound tokens must carry)
AGENTB_RESOURCE_URL=https://agentb.example.okta.com

# ============================================================================
# AGENT B — IDENTITY (its own workload-principal credentials)
# ============================================================================
OKTA_DOMAIN=example.okta.com
AGENTB_AI_AGENT_ID=wlp...
AGENTB_AI_AGENT_PRIVATE_KEY_FILE=agentb-private-key.pem
AGENTB_AI_AGENT_PRIVATE_KEY_KID=...

# ============================================================================
# AGENT B — LLM (makes Agent B an intelligent agent; copied from agent0 by setup:a2a)
# ============================================================================
# Configure EITHER Anthropic OR AWS Bedrock. If omitted, Agent B falls back to
# deterministic add/list handling.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ============================================================================
# AGENT B — INBOUND VALIDATION (agent0 → Agent B)
# ============================================================================
# The A2A authorization server that issued the inbound access token. Agent B
# verifies issuer + aud (= AGENTB_RESOURCE_URL) + scope (agent.invoke).
A2A_AUTHORIZATION_SERVER=https://example.okta.com/oauth2/aus...
# Optional: override the required inbound scope (default: agent.invoke)
# AGENTB_REQUIRED_SCOPE=agent.invoke

# ============================================================================
# AGENT B — OUTBOUND SECOND HOP (Agent B → todo0 MCP)
# ============================================================================
MCP_SERVER_URL=http://localhost:5002/mcp
MCP_AUTHORIZATION_SERVER=https://example.okta.com/oauth2/aus...
MCP_AUTHORIZATION_SERVER_TOKEN_ENDPOINT=https://example.okta.com/oauth2/aus.../v1/token
MCP_RESOURCE_INDICATOR=mcp://todo0
AGENTB_MCP_SCOPES_TO_REQUEST=mcp:connect mcp:tools:read mcp:tools:manage
