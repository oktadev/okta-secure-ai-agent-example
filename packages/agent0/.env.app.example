# ============================================================================
# RESOURCE SERVER CONFIGURATION
# ============================================================================
PORT=3000
SESSION_SECRET=your-session-secret-change-in-production

# ============================================================================
# DEBUG CONFIGURATION
# ============================================================================
# Enable verbose auth logging (includes sensitive data like tokens, auth codes)
# WARNING: Only enable for local debugging, never in production
# AUTH_DEBUG=true

# ============================================================================
# RESOURCE SERVER - OKTA OAUTH (HUMAN SSO)
# ============================================================================
OKTA_DOMAIN=your-domain.okta.com
OKTA_CLIENT_ID=your_client_id_here
OKTA_CLIENT_SECRET=your_client_secret_here
OKTA_REDIRECT_URI=http://localhost:3000/callback
