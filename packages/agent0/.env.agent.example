# ============================================================================
# AGENT - OPTIONAL CONNECTIONS
# ============================================================================
# Comma-separated list of managed-connection kinds to disable. Kinds listed
# here will not build their runtime config, will not register LLM tools, and
# will be reported with `disabled: true` on GET /api/connections/status.
#
# Valid kinds: authorization_server, application, secret, service_account, mcp_server
#
# Use this when your tenant does not have access to the corresponding Okta
# feature (e.g., OPA for `secret`, SaaS-app brokering for `service_account`).
# DISABLED_CONNECTIONS=secret,service_account

# ============================================================================
# AGENT - MCP CLIENT CONFIGURATION
# ============================================================================
MCP_SERVER_URL=http://localhost:5002/mcp
# Optional: set after `pnpm register:mcp` completes. Surfaces in the
# Connections panel as "registered at Okta". Find the id in
# .mcp-register-state.json after registration.
# OKTA_MCP_SERVER_ID=ems...
# Optional: override the resource indicator advertised in
# /.well-known/oauth-protected-resource. Set to the tunnel URL + /mcp
# when registering a local MCP with Okta via a tunnel (ngrok/cloudflared).
# MCP_RESOURCE_INDICATOR=https://<tunnel>.trycloudflare.com/mcp

# ============================================================================
# AGENT - LLM INTEGRATION CONFIGURATION
# ============================================================================
# Configure EITHER Anthropic Direct OR AWS Bedrock

# Anthropic Direct
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AWS Bedrock (alternative)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_SESSION_TOKEN=your_aws_session_token  # Optional for temporary credentials
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ============================================================================
# AGENT - CROSS-APP ACCESS (ID-JAG TOKEN EXCHANGE)
# ============================================================================
# Agent's identity in Okta (workload identity)
OKTA_DOMAIN=your-domain.okta.com
AI_AGENT_ID=your_agent_client_id_here

# Path to private key file for JWT authentication (relative to agent0 package)
AI_AGENT_PRIVATE_KEY_FILE=agent0-private-key.pem

# Key ID for the private key
AI_AGENT_PRIVATE_KEY_KID=your_key_id_here

# MCP scopes to request
AI_AGENT_TODO_MCP_SERVER_SCOPES_TO_REQUEST=mcp:connect mcp:tools:read mcp:tools:manage

# MCP Authorization Server configuration
MCP_AUTHORIZATION_SERVER=https://your-domain.okta.com/oauth2/your_mcp_auth_server_id
MCP_AUTHORIZATION_SERVER_TOKEN_ENDPOINT=https://your-domain.okta.com/oauth2/your_mcp_auth_server_id/v1/token

# ============================================================================
# AGENT - OAUTH STS BROKERED CONSENT (GitHub via Okta)
# ============================================================================
# Resource Indicator from the managed connection in Okta admin console
# (Directory > AI Agents > {Agent} > Managed connections > Resource Indicator)
# This enables the agent to obtain GitHub access tokens brokered through Okta
# OAUTH_STS_RESOURCE=

# ============================================================================
# AGENT - GITHUB MCP (second MCP, OAuth STS-authed)
# ============================================================================
# Optional. When both vars below are set, agent0 connects to GitHub's remote
# MCP in addition to the primary (Todo0) MCP. Auth for this MCP uses OAuth
# STS (not ID-JAG) — GitHub's AS does not advertise identity chaining.
#
# GITHUB_MCP_SERVER_URL is the MCP transport URL (what the SDK client
# connects to). OAUTH_STS_RESOURCE_GITHUB_MCP is a DIFFERENT value — it is
# the Resource Indicator shown on the managed connection in the Okta admin
# console (Directory > AI Agents > {Agent} > Managed connections > GitHub
# MCP > Resource Indicator). Depending on how the managed connection was
# created, this can be either a URL or an ORN — copy it verbatim from Okta.
#
# Example (URL-style resource):
# GITHUB_MCP_SERVER_URL=https://api.githubcopilot.com/mcp/
# OAUTH_STS_RESOURCE_GITHUB_MCP=https://api.githubcopilot.com/mcp
#
# Example (ORN-style resource, Okta-tenant-specific):
# GITHUB_MCP_SERVER_URL=https://api.githubcopilot.com/mcp/
# OAUTH_STS_RESOURCE_GITHUB_MCP=orn:<okta-env>:idp:<org-id>:client-auth-settings:<resource-id>
#
# Trailing-slash gotcha (URL-style only): Okta normalizes the MCP
# resourceUrl on registration (submit `.../mcp/`, stored as `.../mcp`).
# Whatever Okta stored is what must appear in OAUTH_STS_RESOURCE_GITHUB_MCP.
#
# Optional: Okta mcpServerId for the GitHub MCP registration (surfaces in
# /api/connections/status as "registered at Okta"). Find in
# .mcp-register-state.github.json after registration.
# OKTA_GITHUB_MCP_SERVER_ID=ems...
